# Copie este archivo a .env y complete los valores en su equipo.
# .env no se versiona.
#
# MongoDB local. La base usada por los notebooks es secop.
MONGO_URI=mongodb://USUARIO:CLAVE@localhost:27017/secop?authSource=admin
MONGO_DB=secop

# Token opcional de datos.gov.co. Aumenta el cupo de la API durante la ingesta.
SOCRATA_APP_TOKEN=

# PostgreSQL. La base analítica es analytics. El catálogo DIVIPOLA está en public.dim_municipio.
PGHOST=localhost
PGPORT=5432
PGDATABASE=analytics
PGUSER=USUARIO
PGPASSWORD=CLAVE

# Carpeta local del parquet de personas del CNPV 2018. Sin este valor, el notebook 08 no lee el censo.
CNPV_PARQUET=

# Spark local. Deje SPARK_MASTER vacío para usar local[*].
SPARK_MASTER=
SPARK_DRIVER_MEMORY=4g

# Evaluación documental y asistente. No escriba claves reales en este ejemplo.
OPENAI_API_KEY=
CHAT_API=
RAG_URL=http://localhost:8091
PORT=3001
PERIODO=2026-09
VERSION_MODELO=c1_if_v1
